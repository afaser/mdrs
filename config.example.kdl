// mdrs config
// $XDG_CONFIG_HOME/mdrs/config.kdl или ~/.config/mdrs/config.kdl
// путь можно переопределить MDRS_CONFIG

window {
    width 1000
    height 750
    antialiasing #true
    padding 24
    // transparent включается сам при background-opacity < 1
}

theme {
    palette {
        background "#1e1e2e"
        background-opacity 1.0
        text "#cdd6f4"
        accent "#a6e3a1"
        danger "#f38ba8"
        border "#45475a"
        surface "#313244"
        selection "#45475a"
        primary "#a6e3a1"
        success "#a6e3a1"
        warning "#f38ba8"
    }

    fonts {
        use-system #false

        latin {
            family "Source Serif 4"
            script "latin"
            regular "embedded"
            bold "embedded"
            italic "embedded"
            bold-italic "system"
        }

        cyrillic {
            family "Lora"
            script "cyrillic"
            regular "embedded"
            bold "embedded"
            italic "embedded"
            bold-italic "system"
        }

        code {
            family "JetBrainsMono Nerd Font"
            script "any"
            regular "embedded"
            bold "system"
            italic "system"
            bold-italic "system"
            ligatures #true
        }

        sets {
            body {
                regular "latin" "cyrillic"
                bold "latin" "cyrillic"
                italic "latin" "cyrillic"
                bold-italic "latin" "cyrillic"
            }

            heading {
                regular "latin" "cyrillic"
                bold "latin" "cyrillic"
                italic "latin" "cyrillic"
                bold-italic "latin" "cyrillic"
            }

            code {
                regular "code"
                bold "code"
                italic "code"
                bold-italic "code"
            }
        }
    }

    text {
        body {
            font "body"
            size 17
            weight "normal"
            line-height 1.3
            letter-spacing 0
            color "text"
        }

        heading {
            font "heading"
            color "accent"
            line-height 1.3
            letter-spacing 0
            heading-gap 8.5
            h1 { size 34; weight "normal" }
            h2 { size 29.75; weight "normal" }
            h3 { size 25.5; weight "normal" }
            h4 { size 21.25; weight "normal" }
            h5 { size 17; weight "normal" }
            h6 { size 17; weight "normal" }
        }

        inline-code {
            font "code"
            size 13
            weight "normal"
            line-height 1.3
            letter-spacing 0.5
            color "text"
            background "surface"
            padding { top 4; right 4; bottom 4; left 4 }
            radius 4
        }

        message {
            font "body"
            size 18
            weight "normal"
            line-height 1.3
            color "danger"
        }

        link {
            color "accent"
            underline #false
            letter-spacing 0
            // fonts "latin" "cyrillic"
            // size 17
            // weight "normal"
            // line-height 1.3
        }

        spacing 14.875
    }

    code-block {
        text {
            font "code"
            size 13
            weight "normal"
            line-height 1.3
            color "text"
            ligatures #true
        }

        frame {
            background "surface"
            border { color "border"; width 1; radius 12 }
            margin 8
        }

        header {
            show #true
            height 32
            background "background"
            padding { top 0; right 0; bottom 0; left 12 }

            logo {
                fonts "code"
                size 16
            }

            logos {
                // вместо icon можно указать icon-path "/path/rust.svg"
                rust { icon "\u{e7a8}"; color "#fab387" }
                bash { icon "\u{e795}"; color "accent" }
                // python { icon "\u{e73c}"; color "#f9e2af" }
                // javascript { icon "\u{e74e}"; color "#f9e2af" }
                unknown { icon "\u{f0f6}"; color "text" }
            }

            label {
                fonts "code"
                size 13
                color "text"
                capitalize #true
                unknown "Text"
            }

            copy {
                icon "embedded"              // встроенная SVG
                // icon "\u{f0c5}"          // glyph
                // icon-path "/path/copy.svg"
                check-icon "embedded"        // встроенная SVG
                // check-icon "\u{f00c}"
                // check-icon-path "/path/check.svg"
                size 20
                button-size 28
                color "text"
                hover-color "accent"
                background "#00000000"
                hover-background "surface"
                radius 8
                check-color "success"
                check-duration 0.9
                check-easing "0.25 0.1 0.25 1"
                hover-duration 0.15
                hover-easing "0.25 0.1 0.25 1"
            }
        }

        content {
            padding 12
            scrollbar {
                track "background"
                thumb "border"
                thumb-hover "accent"
                width 7
                scroller-width 7
                spacing 3.5
            }
        }
    }

    scrollbars {
        document {
            track "background"
            thumb "border"
            thumb-hover "accent"
            width 8
            scroller-width 6
            spacing 8
        }
    }

    motion {
        wheel {
            smoothing 0.03
            settle-distance 0.5
            lines-per-notch 8
            pixels-per-notch 15
            line-height 24
            external-distance 0.5
        }
    }

    selection {
        color "selection"
        decoration {
            underline-offset 0.08
            strikethrough-offset 0.5
        }
    }

    highlighting {
        theme "CatppuccinMocha"
        // theme-file "/path/to/custom.tmTheme"
        tokens {
            // keyword "#cba6f7"
            // string "#a6e3a1"
            // comment "#6c7086"
            // number "#fab387"
            // function "#89b4fa"
            // type "#f9e2af"
            // operator "#89dceb"
            // punctuation "#9399b2"
        }
    }
}
